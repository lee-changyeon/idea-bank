{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "includeFiles": ["web/server.py", "web/ibweb/**", "web/static/**", "ideabank/**", "config.json"]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/api/index.py" }],
  "crons": [{ "path": "/api/cron/tsa", "schedule": "0 3 * * *" }]
}
